# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=4010
APP_URL=http://localhost:5173
API_URL=http://localhost:4010
LOG_LEVEL=info

# Local embedded Postgres (npm run db:local) listens on 5433; docker-compose uses 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/recruitflow

# ─── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# ─── Redis / BullMQ (optional — falls back to in-process queue & memory cache) ───
REDIS_URL=
# Set to false when running `npm run worker` as a separate process.
RUN_WORKERS_IN_API=true

# ─── File storage (optional — falls back to local ./uploads) ───
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── AI (optional — falls back to deterministic heuristic engine) ───
# Any OpenAI-compatible chat completions API.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── Email (optional — emails are logged to console when SMTP is unset) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RecruitFlow <no-reply@recruitflow.dev>"

# ─── Stripe (optional — mock billing when unset) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=
